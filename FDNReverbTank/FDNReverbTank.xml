<?xml version="1.0" encoding="utf-8" ?>
<PluginList>
  <Plugin
      id="Pandocrator FDN Reverb Tank v2"
      name="FDN Reverb Tank v2"
      category="Pandocrator DSP">

    <Audio>
      <Pin name="Input L" direction="in" datatype="float" rate="audio" default="0.0" />
      <Pin name="Input R" direction="in" datatype="float" rate="audio" default="0.0" />

      <!-- SynthEdit audio/control pins display 10x their XML/internal value. -->
      <Pin name="Decay RT60 s" direction="in" datatype="float" rate="audio" default="0.4" />
      <Pin name="Master Size" direction="in" datatype="float" rate="audio" default="0.1" />

      <!-- Frequency-dependent decay ratios relative to the main RT60.
           LF 1.15 = lows decay 15% longer; HF 0.55 = highs decay 45% faster. -->
      <Pin name="LF Decay Ratio" direction="in" datatype="float" rate="audio" default="0.115" />
      <Pin name="HF Decay Ratio" direction="in" datatype="float" rate="audio" default="0.055" />
      <Pin name="Low Crossover Hz" direction="in" datatype="float" rate="audio" default="25.0" />
      <Pin name="High Crossover Hz" direction="in" datatype="float" rate="audio" default="600.0" />

      <!-- Very small modulation is normally enough: e.g. 0.05..0.20 ms, 0.05..0.25 Hz. -->
      <Pin name="Mod Depth ms" direction="in" datatype="float" rate="audio" default="0.01" />
      <Pin name="Mod Rate Hz" direction="in" datatype="float" rate="audio" default="0.01" />

      <!-- 0 = mono wet output, 1 = normal stereo, up to 2 = exaggerated width. -->
      <Pin name="Stereo Width" direction="in" datatype="float" rate="audio" default="0.1" />

      <!-- Freeze: 0 = normal, 1 = cut new input and make the internal loop lossless. -->
      <Pin name="Freeze" direction="in" datatype="float" rate="audio" default="0.0" />

      <!-- Static delay decorrelation. Seed 0 = auto per instance; Seed > 0 = deterministic recall. -->
      <Pin name="Random Offset ms" direction="in" datatype="float" rate="audio" default="0.10" />
      <Pin name="Random Seed" direction="in" datatype="float" rate="audio" default="10.1" />

      <!-- Signed/permuted Hadamard variant derived from Random Seed. 0 = plain H8, 1 = shuffled H8. -->
      <Pin name="Matrix Shuffle" direction="in" datatype="float" rate="audio" default="0.1" />

      <Pin name="Delay 1 ms" direction="in" datatype="float" rate="audio" default="3.713" />
      <Pin name="Delay 2 ms" direction="in" datatype="float" rate="audio" default="4.111" />
      <Pin name="Delay 3 ms" direction="in" datatype="float" rate="audio" default="4.729" />
      <Pin name="Delay 4 ms" direction="in" datatype="float" rate="audio" default="5.317" />
      <Pin name="Delay 5 ms" direction="in" datatype="float" rate="audio" default="6.131" />
      <Pin name="Delay 6 ms" direction="in" datatype="float" rate="audio" default="7.123" />
      <Pin name="Delay 7 ms" direction="in" datatype="float" rate="audio" default="7.943" />
      <Pin name="Delay 8 ms" direction="in" datatype="float" rate="audio" default="8.917" />

      <Pin name="Wet L" direction="out" datatype="float" rate="audio" />
      <Pin name="Wet R" direction="out" datatype="float" rate="audio" />
    </Audio>
  </Plugin>
</PluginList>
