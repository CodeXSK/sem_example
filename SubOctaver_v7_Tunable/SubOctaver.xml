<?xml version="1.0" encoding="utf-8" ?>
<PluginList>
  <Plugin
      id="Pandocrator Sub Octaver Tunable"
      name="Sub Octaver -1 Tunable"
      category="Pandocrator DSP">

    <Audio>
      <Pin name="Signal In" direction="in" datatype="float" rate="audio" default="0.0" />
      <Pin name="Dry Level" direction="in" datatype="float" rate="audio" default="0.0" />
      <Pin name="Sub Level" direction="in" datatype="float" rate="audio" default="0.75" />
      <Pin name="Tone" direction="in" datatype="float" rate="audio" default="0.45" />
      <Pin name="Tracking" direction="in" datatype="float" rate="audio" default="0.50" />
      <Pin name="Sensitivity" direction="in" datatype="float" rate="audio" default="0.65" />

      <!-- v7 anti-tail controls. Values are milliseconds and may be changed live from SynthEdit. -->
      <Pin name="Envelope Release ms" direction="in" datatype="float" rate="audio" default="45.0" />
      <Pin name="Gate Release ms" direction="in" datatype="float" rate="audio" default="35.0" />
      <Pin name="Tail Fade ms" direction="in" datatype="float" rate="audio" default="5.0" />
      <Pin name="Zero-Cross Timeout ms" direction="in" datatype="float" rate="audio" default="30.0" />

      <Pin name="Sub Out" direction="out" datatype="float" rate="audio" />
      <Pin name="Mix Out" direction="out" datatype="float" rate="audio" />
    </Audio>
  </Plugin>
</PluginList>
