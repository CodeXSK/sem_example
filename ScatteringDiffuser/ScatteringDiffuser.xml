<?xml version="1.0" encoding="utf-8" ?>
<PluginList>
  <Plugin
      id="Pandocrator Scattering Diffuser v1"
      name="Scattering Diffuser v1"
      category="Pandocrator DSP">

    <Audio>
      <Pin name="Signal In" direction="in" datatype="float" rate="audio" default="0.0" />

      <!-- 1..4 scattering banks. Continuous values crossfade between adjacent bank outputs. -->
      <Pin name="Density" direction="in" datatype="float" rate="audio" default="0.4" />

      <!-- -1 dark, 0 neutral, +1 subtly brighter. -->
      <Pin name="Tone" direction="in" datatype="float" rate="audio" default="-0.015" />

      <!-- Multiplies every delay time. 1.0 = original size. -->
      <Pin name="Master Size" direction="in" datatype="float" rate="audio" default="0.1" />

      <!-- Static timing decorrelation. Seed 0 = unique pattern for each new instance. -->
      <Pin name="Random Offset ms" direction="in" datatype="float" rate="audio" default="0.08" />
      <Pin name="Random Seed" direction="in" datatype="float" rate="audio" default="0.0" />

      <!-- Orthonormal Hadamard scattering after every 4-delay bank. -->
      <Pin name="Matrix Enable" direction="in" datatype="float" rate="audio" default="0.1" />
      <Pin name="Matrix Amount" direction="in" datatype="float" rate="audio" default="0.1" />

      <!-- Optional deterministic lane variation derived from Random Seed. -->
      <Pin name="Shuffle Time" direction="in" datatype="float" rate="audio" default="0.0" />
      <Pin name="Shuffle Polarity" direction="in" datatype="float" rate="audio" default="0.0" />

      <Pin name="Stereo Spread" direction="in" datatype="float" rate="audio" default="0.1" />

      <!-- Stage 1 -->
      <Pin name="Delay 1 ms" direction="in" datatype="float" rate="audio" default="0.370" />
      <Pin name="Delay 2 ms" direction="in" datatype="float" rate="audio" default="0.530" />
      <Pin name="Delay 3 ms" direction="in" datatype="float" rate="audio" default="0.710" />
      <Pin name="Delay 4 ms" direction="in" datatype="float" rate="audio" default="0.890" />

      <!-- Stage 2 -->
      <Pin name="Delay 5 ms" direction="in" datatype="float" rate="audio" default="0.590" />
      <Pin name="Delay 6 ms" direction="in" datatype="float" rate="audio" default="0.830" />
      <Pin name="Delay 7 ms" direction="in" datatype="float" rate="audio" default="1.170" />
      <Pin name="Delay 8 ms" direction="in" datatype="float" rate="audio" default="1.410" />

      <!-- Stage 3 -->
      <Pin name="Delay 9 ms" direction="in" datatype="float" rate="audio" default="0.910" />
      <Pin name="Delay 10 ms" direction="in" datatype="float" rate="audio" default="1.270" />
      <Pin name="Delay 11 ms" direction="in" datatype="float" rate="audio" default="1.730" />
      <Pin name="Delay 12 ms" direction="in" datatype="float" rate="audio" default="2.110" />

      <!-- Stage 4 -->
      <Pin name="Delay 13 ms" direction="in" datatype="float" rate="audio" default="1.370" />
      <Pin name="Delay 14 ms" direction="in" datatype="float" rate="audio" default="1.910" />
      <Pin name="Delay 15 ms" direction="in" datatype="float" rate="audio" default="2.530" />
      <Pin name="Delay 16 ms" direction="in" datatype="float" rate="audio" default="3.170" />

      <Pin name="Signal Out" direction="out" datatype="float" rate="audio" />
      <Pin name="Left Out" direction="out" datatype="float" rate="audio" />
      <Pin name="Right Out" direction="out" datatype="float" rate="audio" />

      <Pin name="Lane Out 1" direction="out" datatype="float" rate="audio" />
      <Pin name="Lane Out 2" direction="out" datatype="float" rate="audio" />
      <Pin name="Lane Out 3" direction="out" datatype="float" rate="audio" />
      <Pin name="Lane Out 4" direction="out" datatype="float" rate="audio" />
    </Audio>
  </Plugin>
</PluginList>
