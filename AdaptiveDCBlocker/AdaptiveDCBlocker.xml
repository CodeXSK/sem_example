<?xml version="1.0" encoding="utf-8" ?>
<PluginList>
  <Plugin
      id="Pandocrator Adaptive DC Blocker v1"
      name="Adaptive DC Blocker - Zero Tail"
      category="Pandocrator DSP">
    <Audio>
      <Pin name="Signal L" direction="in" datatype="float" rate="audio" default="0.0" />
      <Pin name="Signal R" direction="in" datatype="float" rate="audio" default="0.0" />
      <Pin name="External Detect In" direction="in" datatype="float" rate="audio" default="0.0" />
      <!-- 0: detect on Signal L/R; 1: detect from External Detect In -->
      <Pin name="Use External Detect" direction="in" datatype="float" rate="audio" default="0.0" />
      <Pin name="Cutoff Hz" direction="in" datatype="float" rate="audio" default="5.0" />
      <Pin name="HP Stages 1 or 2" direction="in" datatype="float" rate="audio" default="2.0" />
      <Pin name="Silence Threshold dB" direction="in" datatype="float" rate="audio" default="-90.0" />
      <Pin name="Silence Hold ms" direction="in" datatype="float" rate="audio" default="5.0" />
      <Pin name="Tail Fade ms" direction="in" datatype="float" rate="audio" default="3.0" />
      <Pin name="Wake Fade ms" direction="in" datatype="float" rate="audio" default="2.0" />
      <Pin name="Out L" direction="out" datatype="float" rate="audio" />
      <Pin name="Out R" direction="out" datatype="float" rate="audio" />
      <Pin name="Activity Gain Out" direction="out" datatype="float" rate="audio" />
    </Audio>
  </Plugin>
</PluginList>
