<?xml version="1.0" encoding="utf-8" ?>
<PluginList>
  <Plugin
      id="Pandocrator Sub Octaver"
      name="Sub Octaver -1"
      category="Pandocrator DSP">

    <Audio>
      <Pin
          name="Signal In"
          direction="in"
          datatype="float"
          rate="audio"
          default="0.0" />

      <Pin
          name="Dry Level"
          direction="in"
          datatype="float"
          rate="audio"
          default="0.0" />

      <Pin
          name="Sub Level"
          direction="in"
          datatype="float"
          rate="audio"
          default="0.75" />

      <Pin
          name="Tone"
          direction="in"
          datatype="float"
          rate="audio"
          default="0.45" />

      <Pin
          name="Tracking"
          direction="in"
          datatype="float"
          rate="audio"
          default="0.50" />

      <Pin
          name="Sensitivity"
          direction="in"
          datatype="float"
          rate="audio"
          default="0.65" />

      <Pin
          name="Sub Out"
          direction="out"
          datatype="float"
          rate="audio" />

      <Pin
          name="Mix Out"
          direction="out"
          datatype="float"
          rate="audio" />
    </Audio>
  </Plugin>
</PluginList>
